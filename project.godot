; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="lightswitch"
config/version="0.26"
run/main_scene="uid://b6fa2np4sh5pu"
config/features=PackedStringArray("4.4", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://resources/default_bus_layout.tres"

[autoload]

sb="*res://singletons/signal_bus.gd"
gb="*res://singletons/global_variables.gd"
gf="*res://singletons/global_functions.gd"
pm="*res://singletons/progress_manager.gd"
er="*res://singletons/event_randomizer.gd"
slm="*res://singletons/save_load_manager.gd"
am="*res://singletons/audio_manager.tscn"
sw="*res://steamworks.gd"
ap="*res://singletons/achievement_progress.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/max_log_files=10
gdscript/warnings/unused_parameter=0

[display]

window/size/mode=3
window/size/resizable=false

[editor]

movie_writer/movie_file="E:/OBS Recordings/movie.avi"

